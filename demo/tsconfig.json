{
	"extends": "../.svelte-kit-demo/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler"
	},
	"include": [
		"./**/*.ts",
		"./**/*.svelte",
		"../src/lib/**/*.ts",
		"../src/lib/**/*.svelte",
		"../src/routes/(admin)/_components/**/*.svelte",
		"../src/routes/(public)/_components/**/*.svelte",
		"../src/app.d.ts"
	],
	"exclude": ["../src/lib/server/**", "../src/routes/(public)/_components/brief.svelte"]
}
